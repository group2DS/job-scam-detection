# ==========================================
# Data files
# ==========================================

# Ignore dataset files by default
*.csv
*.xls
*.xlsx
*.parquet

# Keep data folder structure via placeholders
!data/**/.gitkeep

# Track demonstration registry CSVs
!data/external/
!data/external/*.csv


# ==========================================
# Local databases
# ==========================================

*.db
*.sqlite
*.sqlite3


# ==========================================
# Models and generated artifacts
# ==========================================

*.pkl
*.joblib
*.h5
*.pt
*.onnx
models/
mlruns/


# ==========================================
# Python
# ==========================================

__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/


# ==========================================
# Environments and secrets
# ==========================================

.venv/
venv/
env/
.env
.env.*
*.envrc


# ==========================================
# Notebooks
# ==========================================

.ipynb_checkpoints/


# ==========================================
# Editors and operating systems
# ==========================================

.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp


# ==========================================
# Streamlit
# ==========================================

.streamlit/secrets.toml


# ==========================================
# Logs
# ==========================================

*.log
logs/