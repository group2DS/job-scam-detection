# ==========================================
# Data files & Exceptions
# ==========================================

# Ignore dataset files
*.csv
*.xls
*.xlsx
*.parquet

# Explicitly permit tracking in specific folders
!data/
!data/**/
!data/external/*.csv

# Keep folder structure placeholders
!data/**/.gitkeep


# ==========================================
# Local databases
# ==========================================

*.db
*.sqlite
*.sqlite3


# ==========================================
# Models and generated artifacts
# ==========================================

*.pkl
*.joblib
*.h5
*.pt
*.onnx
/artifacts/
mlruns/

# Explicit model exceptions (placed AFTER *.pkl rule)
!artifacts/
!artifacts/model.pkl
!artifacts/vectorizer.pkl


# ==========================================
# Python
# ==========================================

__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/


# ==========================================
# Environments and secrets
# ==========================================

.venv/
venv/
env/
.env
.env.*
*.envrc


# ==========================================
# Notebooks
# ==========================================

.ipynb_checkpoints/


# ==========================================
# Editors and operating systems
# ==========================================

.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp


# ==========================================
# Streamlit & Secrets
# ==========================================

.streamlit/secrets.toml


# ==========================================
# Logs
# ==========================================

*.log
logs/