def test_submit_decision_omits_blank_reviewer(monkeypatch):
    request_mock = patch_request(monkeypatch, response=make_response(
        json_data={"review_status": "resolved"}
    ))
    HakikiHireAPIClient().submit_decision(
        "C-TEST01", "confirmed_scam", "Evidence reviewed.", "   "
    )
    assert request_mock.call_args.kwargs["json"] == {
        "outcome": "confirmed_scam",
        "notes": "Evidence reviewed.",
    }


def test_submit_decision_includes_reviewer(monkeypatch):
    request_mock = patch_request(monkeypatch, response=make_response(
        json_data={"review_status": "resolved"}
    ))
    HakikiHireAPIClient().submit_decision(
        "C-TEST01",
        "confirmed_scam",
        "Evidence reviewed.",
        " Hakiki Hire Administrator ",
    )
    assert request_mock.call_args.kwargs["json"]["reviewer"] == (
        "Hakiki Hire Administrator"
    )
